# Multi-stage build for AIDevelo.ai - Optimized Version
# Build arguments for versioning
ARG NODE_VERSION=20
ARG ALPINE_VERSION=3.19

####################
# Stage 1: Dependencies Base
####################
FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION} AS deps-base

# Install security updates and common tools
RUN apk update && \
    apk upgrade --no-cache && \
    apk add --no-cache \
        dumb-init \
        tini && \
    rm -rf /var/cache/apk/*

# Create non-root user early
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

####################
# Stage 2: Frontend Dependencies
####################
FROM deps-base AS frontend-deps

# Copy only package files for better layer caching
COPY --chown=nodejs:nodejs package*.json ./

# Install dependencies with optimizations
RUN npm ci --legacy-peer-deps \
    --prefer-offline \
    --no-audit \
    --progress=false && \
    npm cache clean --force

####################
# Stage 3: Build Frontend
####################
FROM frontend-deps AS frontend-builder

# Copy source files
COPY --chown=nodejs:nodejs . .

# Build frontend with production optimizations
ENV NODE_ENV=production
RUN npm run build && \
    # Remove source maps in production (optional)
    find dist -name "*.map" -type f -delete

####################
# Stage 4: Backend Dependencies
####################
FROM deps-base AS backend-deps

WORKDIR /app/server

# Copy only package files
COPY --chown=nodejs:nodejs server/package*.json ./

# Install all dependencies (including dev for build)
RUN npm ci --legacy-peer-deps \
    --prefer-offline \
    --no-audit \
    --progress=false

####################
# Stage 5: Build Backend
####################
FROM backend-deps AS backend-builder

# Copy backend source
COPY --chown=nodejs:nodejs server/ .

# Build TypeScript
RUN npm run build && \
    # Clean up unnecessary files
    rm -rf src/*.ts tests/

####################
# Stage 6: Production Dependencies
####################
FROM deps-base AS prod-deps

WORKDIR /app/server

# Copy package files
COPY --chown=nodejs:nodejs server/package*.json ./

# Install ONLY production dependencies
RUN npm ci --omit=dev \
    --legacy-peer-deps \
    --prefer-offline \
    --no-audit \
    --progress=false && \
    npm cache clean --force

####################
# Stage 7: Final Production Image
####################
FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION}

# Labels for metadata
LABEL maintainer="AIDevelo Team" \
      org.opencontainers.image.title="AIDevelo.ai" \
      org.opencontainers.image.description="AI-powered development platform" \
      org.opencontainers.image.source="https://github.com/your-org/aidevelo.ai" \
      org.opencontainers.image.licenses="MIT"

# Install only runtime dependencies and security updates
RUN apk update && \
    apk upgrade --no-cache && \
    apk add --no-cache \
        dumb-init \
        tini \
        curl && \
    rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# Copy production dependencies from prod-deps stage
COPY --from=prod-deps --chown=nodejs:nodejs /app/server/node_modules ./server/node_modules

# Copy built backend from builder
COPY --from=backend-builder --chown=nodejs:nodejs /app/server/dist ./server/dist
COPY --from=backend-builder --chown=nodejs:nodejs /app/server/package*.json ./server/

# Copy built frontend to serve from backend
COPY --from=frontend-builder --chown=nodejs:nodejs /app/dist ./server/public

# Copy any necessary runtime files
COPY --from=backend-builder --chown=nodejs:nodejs /app/server/src ./server/src

# Create necessary directories with proper permissions
RUN mkdir -p /app/data /app/logs && \
    chown -R nodejs:nodejs /app/data /app/logs

# Switch to non-root user
USER nodejs

# Set production environment
ENV NODE_ENV=production \
    PORT=5000 \
    NODE_OPTIONS="--max-old-space-size=2048"

WORKDIR /app/server

# Expose port
EXPOSE 5000

# Health check with retry logic
HEALTHCHECK --interval=30s \
            --timeout=3s \
            --start-period=40s \
            --retries=3 \
    CMD node -e "require('http').get('http://localhost:5000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use tini for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]

# Start application
CMD ["node", "dist/app.js"]
